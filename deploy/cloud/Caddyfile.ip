{
	# Keep the admin API inside the Caddy container so future config changes can
	# use graceful reloads. Port 2019 is not published by Docker Compose.
	admin localhost:2019
	# Most clients omit SNI when the URL host is an IP address. Select the IP
	# certificate explicitly for those otherwise-valid TLS handshakes.
	default_sni {$PUBLIC_HOST}
	auto_https disable_redirects
}

https://{$PUBLIC_HOST}:30010 {
	tls internal

	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	request_body {
		max_size 110MB
	}

	reverse_proxy api:8000 {
		health_uri /health/ready
		health_interval 15s
		lb_try_duration 5s
		transport http {
			dial_timeout 3s
			response_header_timeout 330s
		}
	}
}
