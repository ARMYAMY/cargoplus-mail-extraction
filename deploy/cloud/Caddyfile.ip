{
	admin off
	auto_https off
}

:30010 {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	request_body {
		max_size 110MB
	}

	reverse_proxy api:8000 {
		health_uri /health/ready
		health_interval 15s
		lb_try_duration 5s
		transport http {
			dial_timeout 3s
			response_header_timeout 330s
		}
	}
}
