# ==========================================
# Cargo Mail Extraction API Service Configuration
# ==========================================

# Environment: development / production / testing
ENVIRONMENT=development
DEBUG=false

# Server Host & Port
HOST=127.0.0.1
PORT=8000
# Docker host port (8001 avoids colliding with a legacy local run.py process)
APP_PORT=8001

# PostgreSQL (Docker Compose service name is `postgres`)
POSTGRES_DB=cargo
POSTGRES_USER=cargo
# Localhost-only default; replace before exposing PostgreSQL outside this machine.
POSTGRES_PASSWORD=cargo-local-password
DATABASE_URL=postgresql+asyncpg://cargo:cargo-local-password@postgres:5432/cargo

# Durable Redis/Celery task queue
TASK_QUEUE_MODE=celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false
CELERY_QUEUE_NAME=cargo-extraction
CELERY_WEBHOOK_QUEUE_NAME=cargo-webhooks
TASK_LEASE_SECONDS=600
TASK_RECOVERY_INTERVAL_SECONDS=30
TASK_DISPATCH_STALE_SECONDS=120
TASK_RECOVERY_BATCH_SIZE=500
MAX_TENANT_PENDING_TASKS=1000
MAX_GLOBAL_PENDING_TASKS=10000

# LLM Inference Configuration (SenseTime API)
LLM_BASE_URL=https://api.senseaudio.cn/v1
LLM_API_KEY=your-sensetime-api-key-here
LLM_MODEL=deepseek-v4-flash-0731
LLM_FALLBACK_MODEL=deepseek-v4-flash-0731
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Skill V3 Assets Base Path (Defaults to ../cargo-mail-extraction-skill-v3)
SKILL_V3_PATH=../cargo-mail-extraction-skill-v3

# Tenant & Billing Settings
DEFAULT_UNIT_PRICE=0.50
# Per-tenant runtime limit: 1-30
DEFAULT_TENANT_CONCURRENCY=20

# Worker Queue & Concurrency
# Process-wide worker pool: 1-100
WORKER_CONCURRENCY=30
TASK_TIMEOUT_SECONDS=300
METRICS_ENABLED=true

# Data Retention & Storage (Days to keep uploaded raw files)
DATA_RETENTION_DAYS=90
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_FILES=10
MAX_UPLOAD_FILE_SIZE=52428800
MAX_LEGACY_DOC_FILE_SIZE=20971520
MAX_UPLOAD_TOTAL_SIZE=104857600

# Webhook Retry Settings
WEBHOOK_MAX_RETRIES=3
WEBHOOK_TIMEOUT_SECONDS=10

# Authentication secrets (generate independent random values, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`)
ADMIN_SECRET_KEY=replace-with-a-random-admin-secret
SESSION_SECRET_KEY=replace-with-a-different-random-session-secret
AUTH_TOKEN_TTL_SECONDS=28800

# Comma-separated browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8001,http://localhost:8001

# Development-only convenience data; keep disabled outside local demos
SEED_DEMO_TENANT=false
